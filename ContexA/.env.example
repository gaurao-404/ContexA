# Local-first default: SQLite. For Postgres, set e.g. postgresql+psycopg://contexa:change-me@localhost:5432/contexa
# Optional override; leave unset for the portable SQLite default.
ENABLE_POSTGRES_RLS=true
# DATABASE_URL=postgresql+psycopg://contexa:change-me@localhost:5432/contexa
# Production: use the Supabase Postgres Transaction Pooler URI for contexa_app.
# DATABASE_URL=postgresql+psycopg://contexa_app.<project-ref>:<password>@<supavisor-host>:6543/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
APP_ENV=development
ALLOW_SIGNUP=true
STORE_UPLOADS_IN_DATABASE=false
WORKSPACE_ID=ws-contexa-demo
MAX_UPLOAD_MB=35
ACCESS_TOKEN_MINUTES=720

# Submission-safe default: no Ollama probe, model download, or external AI request.
# Deterministic governance checks work offline. Opt in to local AI by changing both flags below to true.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron-mini:4b
OLLAMA_REQUEST_TIMEOUT=60
AI_VERIFICATION_ENABLED=false

# Optional legacy cloud fallback only. Leave blank for fully offline rules-only operation.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional Cloudflare AI Gateway (provider key remains server-side).
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<ACCOUNT_ID>/<GATEWAY_ID>/anthropic
# CLOUDFLARE_AI_GATEWAY_TOKEN=<CLOUDFLARE_AI_GATEWAY_TOKEN>

# Optional: defaults to backend/storage
# STORAGE_DIR=./backend/storage

# Account security. Production registration should use SMTP verification.
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ContexA Studio
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PUBLIC_APP_URL=http://localhost:5173
# Production: set comma-separated exact HTTPS origins only.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
AUTH_TOKEN_MINUTES=45
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15
SIGNUP_MAX_PER_IP=25
SIGNUP_WINDOW_MINUTES=60
PASSWORD_RESET_MAX_PER_IP=5
UPLOAD_MAX_PER_USER=40
UPLOAD_WINDOW_MINUTES=60

# Private uploads. Optional S3-compatible storage (AWS S3, Cloudflare R2, MinIO).
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=contexa
S3_FORCE_PATH_STYLE=false
# Leave blank for provider-managed encryption. Set AES256 or aws:kms where supported.
S3_SERVER_SIDE_ENCRYPTION=
REQUIRE_PRIVATE_OBJECT_STORAGE=false
# Cloudflare R2 example (bucket-scoped read/write token; region must be auto):
# S3_BUCKET=contexa-private
# S3_REGION=auto
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_FORCE_PATH_STYLE=false
# Leave S3_SERVER_SIDE_ENCRYPTION blank for R2 provider-managed encryption.

# Optional upload malware scanning. Set UPLOAD_SCAN_MODE=clamd and configure clamd.
UPLOAD_SCAN_MODE=disabled
REQUIRE_MALWARE_SCAN=false
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Optional local embeddings. If enabled, install the model once with:
# ollama pull nomic-embed-text
OLLAMA_EMBEDDINGS_ENABLED=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT=25

# Security-state retention. Expired tokens and old hashed throttle records are pruned at startup.
SECURITY_HEADERS_ENABLED=true
# Extra HTTP(S) origins needed by the browser CSP connect-src policy (comma separated, origins only).
CSP_EXTRA_CONNECT_ORIGINS=
# Cloudflare Workers edge/API gateway (only set true after the Worker is deployed).
CLOUDFLARE_EDGE_ENABLED=false
# Optional shared secret: same value as the Cloudflare Worker ORIGIN_SHARED_SECRET.
# When edge is enabled and this is set, direct /api/* calls to the origin are rejected.
CLOUDFLARE_ORIGIN_SHARED_SECRET=
PUBLIC_API_URL=
# If both TURNSTILE_SECRET_KEY (backend) and VITE_TURNSTILE_SITE_KEY (frontend build) are set,
# login and public workspace registration require a valid, server-verified Turnstile token.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Do not configure only one side of Turnstile; enable both keys together.
AUTH_TOKEN_RETENTION_DAYS=30
LOGIN_ATTEMPT_RETENTION_DAYS=90

# Trust OS security: keep this stable to preserve public passport signatures.
TRUST_PASSPORT_SIGNING_KEY=replace-with-a-stable-64-character-random-secret
# Secret for Cloudflare Cron -> FastAPI scheduled source scans; configure same value as Worker secret.
TRUTH_DRIFT_CRON_TOKEN=replace-with-a-long-random-scheduler-token


# Supabase Auth for the configured ContexA project. The API verifies asymmetric JWTs
# through this project's JWKS and requires email_verified=true from the custom token hook.
# Use AUTH_MODE=hybrid only when you intentionally need local-password fallback during migration.
# Default is local email+password login (demo accounts are seeded when APP_ENV=development).
# To use Supabase instead, set AUTH_MODE=supabase here AND VITE_AUTH_MODE=supabase in frontend/.env,
# then fill the real SUPABASE_* values below.
AUTH_MODE=local
SUPABASE_URL=https://amxhfdbsvlzhyogwnxaw.supabase.co
SUPABASE_JWT_ISSUER=https://amxhfdbsvlzhyogwnxaw.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://amxhfdbsvlzhyogwnxaw.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
SUPABASE_REQUIRE_AAL2=false  # Enable only after MFA enrollment/challenge is configured and tested.
# Same project's direct PostgreSQL URI with read access to auth.sessions; server-side secret only.
SUPABASE_SESSION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_SESSION_CHECK_REQUIRED=false

# AWS trust integrations: use ECS task role / IAM workload identity, not long-lived keys.
AWS_REGION=ap-south-1
TRUST_SIGNING_PROVIDER=local_hmac
TRUST_KMS_KEY_ID=
TRUST_KMS_SIGNING_ALGORITHM=RSASSA_PSS_SHA_256
EVIDENCE_ARCHIVE_BUCKET=
EVIDENCE_ARCHIVE_PREFIX=contexa-evidence
EVIDENCE_ARCHIVE_RETENTION_DAYS=0
EVIDENCE_ARCHIVE_MODE=GOVERNANCE
EVIDENCE_ARCHIVE_SSE=aws:kms
EVIDENCE_ARCHIVE_KMS_KEY_ID=
TRUST_ARCHIVE_REQUIRED=false

# Optional: enables GET /api/metrics for Prometheus (send header X-Metrics-Token). Leave blank to disable.
METRICS_TOKEN=
