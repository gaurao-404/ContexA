# Local-first default: SQLite. For Postgres, set e.g. postgresql+psycopg://contexa:change-me@localhost:5432/contexa
# Optional override; leave unset for the portable SQLite default.
# DATABASE_URL=postgresql+psycopg://contexa:change-me@localhost:5432/contexa
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
APP_ENV=development
WORKSPACE_ID=ws-contexa-demo
MAX_UPLOAD_MB=35
ACCESS_TOKEN_MINUTES=720

# Submission-safe default: no Ollama probe, model download, or external AI request.
# Deterministic governance checks work offline. Opt in to local AI by changing both flags below to true.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=nemotron-mini:4b
OLLAMA_REQUEST_TIMEOUT=60
AI_VERIFICATION_ENABLED=false

# Optional legacy cloud fallback only. Leave blank for fully offline rules-only operation.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: defaults to backend/storage
# STORAGE_DIR=./backend/storage
